APP_NAME=Kahwety
ENVIRONMENT=production
DEBUG=false

# Docker Compose database settings. Use a long unique password in production.
POSTGRES_USER=kahwety
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_DATABASE_PASSWORD
POSTGRES_DB=kahwety
DATABASE_URL=postgresql+asyncpg://kahwety:CHANGE_THIS_TO_A_LONG_UNIQUE_DATABASE_PASSWORD@postgres:5432/kahwety
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30

# Generate with: openssl rand -hex 32
SECRET_KEY=GENERATE_A_64_CHARACTER_RANDOM_SECRET_BEFORE_DEPLOYMENT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=https://admin.example.com
LOG_LEVEL=INFO

# Public domains used by Docker Compose and Nginx.
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

# Authentication abuse protection (per application process)
AUTH_LOGIN_RATE_LIMIT=10
AUTH_OTP_RATE_LIMIT=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Google Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twilio SMS
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
TWILIO_PHONE_NUMBER=

# Moyasar Payments
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_BASE_URL=https://api.moyasar.com/v1
MOYASAR_CALLBACK_URL=https://api.example.com/api/v1/webhooks/moyasar
MOYASAR_SUCCESS_URL=https://admin.example.com/payment/success
MOYASAR_BACK_URL=https://admin.example.com/payment/cancel
