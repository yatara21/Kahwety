{
  "info": {
    "name": "Kahwety API",
    "description": "Current FastAPI routes for the Kahwety production API. Set apiOrigin and accessToken in your Postman environment before sending protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "apiOrigin", "value": "https://api.example.com" },
    { "key": "baseUrl", "value": "{{apiOrigin}}/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "cafeId", "value": "" },
    { "key": "planId", "value": "" },
    { "key": "branchId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "offerId", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "complaintId", "value": "" },
    { "key": "subscriptionId", "value": "" },
    { "key": "couponId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "suggestedCafeId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "GET /health", "request": { "method": "GET", "url": "{{apiOrigin}}/health" } },
        { "name": "GET /ready", "request": { "method": "GET", "url": "{{apiOrigin}}/ready" } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Example Customer\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"Use-a-strong-test-password\",\n  \"role\": \"CUSTOMER\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Use-a-strong-test-password\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        { "name": "POST /auth/google", "request": { "method": "POST", "url": "{{baseUrl}}/auth/google" } },
        { "name": "POST /auth/send-otp", "request": { "method": "POST", "url": "{{baseUrl}}/auth/send-otp" } },
        { "name": "POST /auth/verify-otp", "request": { "method": "POST", "url": "{{baseUrl}}/auth/verify-otp" } },
        { "name": "POST /auth/refresh", "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh" } },
        { "name": "GET /auth/me", "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" } },
        { "name": "POST /auth/logout", "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" } }
      ]
    },
    {
